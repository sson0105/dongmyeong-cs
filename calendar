      <button type="button" onclick="addCustomHoliday()" style="width: auto !important; margin-top: 0 !important; padding: 7px 14px; background: var(--today-accent); color: #fff; border: none; border-radius: 6px; font-size: 12.5px; font-weight: 700; cursor: pointer; white-space: nowrap; flex-shrink: 0;">추가</button>
