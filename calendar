      <button type="button" onclick="document.getElementById('modal').style.display='none'" style="flex: 1.5; padding: 9px; background: var(--ink); color: #ffffff; border: none; border-radius: 6px; font-size: 12.5px; font-weight: 700; cursor: pointer;">닫기</button>
