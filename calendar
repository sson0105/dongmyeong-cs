    <div id="holiday-list-box" style="max-height: 220px; overflow-y: auto; border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; margin-bottom: 14px; background: #fff;"></div>

    <div style="display: flex; justify-content: space-between; align-items: center;">
      <button type="button" onclick="resetDefaultHolidays()" style="width: auto !important; margin-top: 0 !important; background: none; border: none; color: var(--sun); font-size: 12px; cursor: pointer; text-decoration: underline; padding: 0;">기본 공휴일 복원</button>
      <button type="button" onclick="document.getElementById('holiday-modal').style.display='none'" style="width: auto !important; margin-top: 0 !important; padding: 7px 16px; background: var(--ink-2); color: #fff; border: none; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">닫기</button>
