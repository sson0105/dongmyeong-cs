<script>
const API_ENDPOINT = 'https://script.google.com/macros/s/AKfycbz2F6v6AkZxLm2Krw-0rXaeX6buTAd3FJpTaP6tSbEC2mFGTQyCzJHuXBk7mx_9a5fX6g/exec';
const dataCache = {};

  const systemToday = new Date();
  const todayY = systemToday.getFullYear();
  const todayM = systemToday.getMonth() + 1;
  const todayD = systemToday.getDate();
  const todayDateStr = `${todayY}-${String(todayM).padStart(2, '0')}-${String(todayD).padStart(2, '0')}`;

  // [수정] 무조건 현재 날짜 기준 다음 달(익월)로 자동 계산하여 기본값 지정
  const initNextMonthDate = new Date();
  initNextMonthDate.setDate(1); // 말일 오차 방지
  initNextMonthDate.setMonth(initNextMonthDate.getMonth() + 1);

  let viewMode = 'month';
  let currentYear = initNextMonthDate.getFullYear();
  let currentMonth = initNextMonthDate.getMonth() + 1; // 1~12
  let currentWeekStart = new Date(currentYear, currentMonth - 1, 1);

  let pickerYear = currentYear;
  let selectedEvent = null;

  function getStoredAuth() {
    return sessionStorage.getItem('dm_calendar_token') || '';
  }

  async function checkAuthGate() {
    const token = getStoredAuth();
    const overlay = document.getElementById('auth-gate-overlay');

    if (token && token.trim() !== '') {
      if (overlay) overlay.classList.add('hidden');
      await fetchHolidaysFromServer();
      renderCalendar(true);
    } else {
      if (overlay) overlay.classList.remove('hidden');
      setTimeout(() => {
        const input = document.getElementById('gate-password-input');
        if (input) input.focus();
      }, 100);
    }
  }

  async function handleGateAuth(e) {
    e.preventDefault();
    const input = document.getElementById('gate-password-input');
    const errEl = document.getElementById('gate-error-msg');
    const btn = document.getElementById('btn-gate-submit');
    const enteredPw = input.value.trim();

    if (!enteredPw) return;

    btn.disabled = true;
    btn.innerText = '인증 확인 중...';
    errEl.style.display = 'none';

    try {
      const res = await fetch(`${API_ENDPOINT}?type=checkAuth&auth=${encodeURIComponent(enteredPw)}`, {
        redirect: 'follow'
      });
      const data = await res.json();

      if (data && data.authenticated) {
        sessionStorage.setItem('dm_calendar_token', enteredPw);
        const overlay = document.getElementById('auth-gate-overlay');
        if (overlay) overlay.classList.add('hidden');
        await fetchHolidaysFromServer();
        renderCalendar(true);
      } else {
        errEl.style.display = 'block';
        input.value = '';
        input.focus();
      }
    } catch (err) {
      alert('인증 서버 연결 실패: ' + err);
    } finally {
      btn.disabled = false;
      btn.innerText = '접속하기';
    }
  }

  function openCreateModal(defaultDate = '') {
    const dInput = document.getElementById('new-date');
    if (defaultDate) {
      dInput.value = defaultDate;
    } else {
      dInput.value = `${currentYear}-${String(currentMonth).padStart(2, '0')}-01`;
    }
    document.getElementById('new-team').value = '';
    document.getElementById('new-agency').value = '';
    document.getElementById('new-category').value = '선예약팀';
    document.getElementById('new-status').value = '등록 대기';
    document.getElementById('new-fee').value = '무료';
    document.getElementById('new-memo').value = '';
    document.getElementById('create-modal').style.display = 'flex';
  }

  function closeCreateModal(e) {
    if (e.target.id === 'create-modal') {
      document.getElementById('create-modal').style.display = 'none';
    }
  }

  async function handleCreateBooking(e) {
    e.preventDefault();
    const date = document.getElementById('new-date').value;
    const time = document.getElementById('new-time').value;
    const category = document.getElementById('new-category').value;
    const team = document.getElementById('new-team').value.trim();
    const agency = document.getElementById('new-agency').value.trim();
    const status = document.getElementById('new-status').value;
    const fee = document.getElementById('new-fee').value;
    const memo = document.getElementById('new-memo').value.trim();

    const dObj = new Date(date);
    const targetSheetName = `${dObj.getFullYear()}년 ${dObj.getMonth() + 1}월`;

    const btn = document.getElementById('btn-save-booking');
    btn.disabled = true;
    btn.innerText = '시트에 저장 중...';

    const payload = {
      action: 'createReservation',
      sheetName: targetSheetName,
      date: date,
      time: time,
      category: category,
      team: team,
      agency: agency,
      status: status,
      fee: fee,
      memo: memo,
      auth: getStoredAuth()
    };

    try {
      await fetch(API_ENDPOINT, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      document.getElementById('create-modal').style.display = 'none';
      setTimeout(() => {
        renderCalendar(true);
      }, 1200);
    } catch (err) {
      alert('예약 등록 실패: ' + err);
    } finally {
      btn.disabled = false;
      btn.innerText = '스프레드시트에 저장';
    }
  }

  async function quickUpdateStatus(newStatus) {
    if (!selectedEvent || !selectedEvent.rowIndex) {
      alert('선택된 예약 정보가 유효하지 않습니다.');
      return;
    }

    if (!confirm(`대관 상태를 '${newStatus}'(으)로 변경하시겠습니까?`)) return;

    const payload = {
      action: 'updateReservationStatus',
      sheetName: selectedEvent.sheetName,
      rowIndex: selectedEvent.rowIndex,
      newStatus: newStatus,
      auth: getStoredAuth()
    };

    try {
      await fetch(API_ENDPOINT, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      document.getElementById('modal').style.display = 'none';
      setTimeout(() => {
        renderCalendar(true);
      }, 1000);
    } catch (err) {
      alert('상태 변경 중 오류: ' + err);
    }
  }

  async function deleteCurrentEvent() {
    if (!selectedEvent || !selectedEvent.rowIndex) return;

    if (!confirm(`[${selectedEvent.title}] 예약을 스프레드시트에서 완전히 삭제하시겠습니까?`)) return;

    const payload = {
      action: 'deleteReservation',
      sheetName: selectedEvent.sheetName,
      rowIndex: selectedEvent.rowIndex,
      auth: getStoredAuth()
    };

    try {
      await fetch(API_ENDPOINT, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      document.getElementById('modal').style.display = 'none';
      setTimeout(() => {
        renderCalendar(true);
      }, 1000);
    } catch (err) {
      alert('삭제 중 오류: ' + err);
    }
  }

  let serverHolidays = {};

  function fetchHolidaysFromServer() {
    const token = getStoredAuth();
    if (!token) return Promise.resolve({});

    return fetch(`${API_ENDPOINT}?type=holidays&auth=${encodeURIComponent(token)}`, { redirect: 'follow' })
      .then(res => res.json())
      .then(data => {
        serverHolidays = (data && !data.error) ? data : {};
        return serverHolidays;
      })
      .catch(err => {
        console.error('공휴일 연동 실패:', err);
        return {};
      });
  }

  function getHolidays() {
    return serverHolidays;
  }

  async function openHolidayModal() {
    document.getElementById('holiday-modal').style.display = 'flex';
    const box = document.getElementById('holiday-list-box');
    box.innerHTML = '<div style="color: var(--ink-3); text-align: center; padding: 16px 0; font-size: 12px;">공휴일 목록 동기화 중...</div>';
    
    try {
      await fetchHolidaysFromServer();
    } catch (err) {
      console.error(err);
    } finally {
      renderHolidayListBox();
    }
  }

  function closeHolidayModal(e) {
    if (e.target.id === 'holiday-modal') {
      document.getElementById('holiday-modal').style.display = 'none';
    }
  }

  function renderHolidayListBox() {
    const holidays = getHolidays();
    const box = document.getElementById('holiday-list-box');
    box.innerHTML = '';

    const keys = Object.keys(holidays).sort();
    if (keys.length === 0) {
      box.innerHTML = '<div style="color: var(--ink-4); text-align: center; padding: 16px 0; font-size: 12px;">등록된 공휴일이 없습니다.</div>';
      return;
    }

    keys.forEach(dateStr => {
      const row = document.createElement('div');
      row.style.cssText = 'display: flex; justify-content: space-between; align-items: center; padding: 5px 2px; border-bottom: 1px solid var(--line-2); font-size: 12.5px;';
      row.innerHTML = `
        <span><strong style="color: var(--ink); font-family: Manrope;">${dateStr}</strong> <span style="color: var(--sun); font-weight: 600; margin-left: 4px;">${holidays[dateStr]}</span></span>
        <button type="button" onclick="deleteCustomHoliday('${dateStr}')" style="background: none; border: none; color: var(--sun); cursor: pointer; font-size: 11px; padding: 2px 4px;">삭제</button>
      `;
      box.appendChild(row);
    });
  }

  async function postHolidayAction(payload) {
    const box = document.getElementById('holiday-list-box');
    box.innerHTML = '<div style="color: var(--today-accent); text-align: center; padding: 16px 0; font-size: 12px;">구글 시트에 저장하는 중...</div>';
    payload.auth = getStoredAuth();

    try {
      await fetch(API_ENDPOINT, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      setTimeout(async () => {
        await fetchHolidaysFromServer();
        renderHolidayListBox();
        renderCalendar(true);
      }, 1000);
    } catch (err) {
      alert('저장 중 오류 발생: ' + err);
      renderHolidayListBox();
    }
  }

  function addCustomHoliday() {
    const dInput = document.getElementById('input-holiday-date');
    const nInput = document.getElementById('input-holiday-name');
    if (!dInput.value || !nInput.value.trim()) {
      alert('날짜와 공휴일명을 모두 입력해주세요.');
      return;
    }
    postHolidayAction({ action: 'add', date: dInput.value, name: nInput.value.trim() });
    dInput.value = '';
    nInput.value = '';
  }

  function deleteCustomHoliday(dateStr) {
    if (confirm(`${dateStr} 공휴일을 삭제하시겠습니까?`)) {
      postHolidayAction({ action: 'delete', date: dateStr });
    }
  }

  function resetDefaultHolidays() {
    if (confirm('기본 공휴일 목록으로 되돌리시겠습니까?')) {
      postHolidayAction({ action: 'reset' });
    }
  }

  const ALL_SLOTS = [
    { name: '1회차', time: '08:00~10:00' },
    { name: '2회차', time: '10:00~12:00' },
    { name: '3회차', time: '12:00~14:00' },
    { name: '4회차', time: '14:00~16:00' },
    { name: '5회차', time: '16:00~18:00' },
    { name: '6회차', time: '18:00~20:00' }
  ];

  function getOperationalSlots(month) {
    const isWinterSeason = (month >= 10 || month <= 3);
    return isWinterSeason ? ALL_SLOTS.slice(0, 5) : ALL_SLOTS;
  }

  function getCategoryClass(cat) {
    if (cat.includes('선예약')) return 'ev a';
    if (cat.includes('고정')) return 'ev c';
    return 'ev b';
  }

  function toggleMonthPicker(e) {
    e.stopPropagation();
    const popover = document.getElementById('month-picker-popover');
    const trigger = document.getElementById('btn-picker-trigger');
    const isOpen = popover.style.display === 'block';

    if (isOpen) {
      closeMonthPicker();
    } else {
      pickerYear = currentYear;
      renderPickerContent();
      popover.style.display = 'block';
      trigger.classList.add('active');
    }
  }

  function closeMonthPicker() {
    const popover = document.getElementById('month-picker-popover');
    const trigger = document.getElementById('btn-picker-trigger');
    if (popover) popover.style.display = 'none';
    if (trigger) trigger.classList.remove('active');
  }

  function changePickerYear(delta) {
    pickerYear += delta;
    renderPickerContent();
  }

  function renderPickerContent() {
    document.getElementById('popover-year-title').innerText = `${pickerYear}년`;
    const grid = document.getElementById('month-chips-grid');
    let html = '';

    for (let m = 1; m <= 12; m++) {
      const isCurrent = (pickerYear === currentYear && m === currentMonth);
      const chipClass = isCurrent ? 'btn-month-chip current' : 'btn-month-chip';
      html += `<button class="${chipClass}" onclick="selectQuickMonth(${pickerYear}, ${m})">${m}월</button>`;
    }
    grid.innerHTML = html;
  }

  function selectQuickMonth(year, month) {
    currentYear = year;
    currentMonth = month;
    if (viewMode === 'week') {
      currentWeekStart = getSunday(new Date(currentYear, currentMonth - 1, 1));
    }
    closeMonthPicker();
    renderCalendar();
  }

  document.addEventListener('click', () => {
    closeMonthPicker();
  });

  document.addEventListener('keydown', (e) => {
    if (document.getElementById('modal').style.display === 'flex' || 
        document.getElementById('create-modal').style.display === 'flex' ||
        document.getElementById('holiday-modal').style.display === 'flex' || 
        !document.getElementById('auth-gate-overlay').classList.contains('hidden')) return;
    if (e.key === 'ArrowLeft') {
      navigateStep(-1);
    } else if (e.key === 'ArrowRight') {
      navigateStep(1);
    } else if (e.key.toLowerCase() === 't') {
      goToday();
    }
  });

  function setViewMode(mode) {
    viewMode = mode;
    document.getElementById('btn-tab-month').classList.toggle('active', mode === 'month');
    document.getElementById('btn-tab-week').classList.toggle('active', mode === 'week');

    document.getElementById('btn-nav-prev').innerText = mode === 'month' ? '이전 달' : '이전 주';
    document.getElementById('btn-nav-next').innerText = mode === 'month' ? '다음 달' : '다음 주';

    if (mode === 'week') {
      currentWeekStart = getSunday(new Date(currentYear, currentMonth - 1, 4));
    }
    renderCalendar();
  }

  function goToday() {
    const now = new Date();
    currentYear = now.getFullYear();
    currentMonth = now.getMonth() + 1;
    currentWeekStart = getSunday(now);
    renderCalendar();
  }

  function getSunday(d) {
    const date = new Date(d);
    const day = date.getDay();
    const diff = date.getDate() - day;
    return new Date(date.setDate(diff));
  }

  function navigateStep(delta) {
    if (viewMode === 'month') {
      currentMonth += delta;
      if (currentMonth > 12) { currentMonth = 1; currentYear++; }
      if (currentMonth < 1) { currentMonth = 12; currentYear--; }
    } else {
      currentWeekStart.setDate(currentWeekStart.getDate() + (delta * 7));
      currentYear = currentWeekStart.getFullYear();
      currentMonth = currentWeekStart.getMonth() + 1;
    }
    renderCalendar();
  }

  function setBadgeState(state, text) {
    const badge = document.getElementById('top-status-badge');
    const label = document.getElementById('top-status-text');
    badge.className = 'live-status-badge ' + state;
    label.innerText = text;
  }

  function showLoadingOverlay(text = '스프레드시트 데이터 동기화 중...') {
    const overlay = document.getElementById('calendar-loading-overlay');
    const textEl = document.getElementById('loading-overlay-text');
    if (textEl) textEl.innerText = text;
    if (overlay) overlay.classList.add('active');
  }

  function hideLoadingOverlay() {
    const overlay = document.getElementById('calendar-loading-overlay');
    if (overlay) overlay.classList.remove('active');
  }

  const CACHE_TTL_MS = 5 * 60 * 1000;

  function renderCalendar(forceRefresh = false) {
    const token = getStoredAuth();
    if (!token) return;

    const titleEl = document.getElementById('header-date-title');
    if (viewMode === 'month') {
      titleEl.innerText = `${currentYear}년 ${currentMonth}월`;
    } else {
      const weekEnd = new Date(currentWeekStart);
      weekEnd.setDate(weekEnd.getDate() + 6);
      titleEl.innerText = `${currentYear}년 ${currentMonth}월 (${currentWeekStart.getMonth()+1}.${currentWeekStart.getDate()} ~ ${weekEnd.getMonth()+1}.${weekEnd.getDate()})`;
    }

    const sheetName = `${currentYear}년 ${currentMonth}월`;
    const cachedEntry = dataCache[sheetName];
    const isCacheValid = cachedEntry && (Date.now() - cachedEntry.timestamp < CACHE_TTL_MS);

    // 날짜 틀 선행 렌더링
    if (!cachedEntry) {
      drawView([]);
    }

    if (!forceRefresh && isCacheValid) {
      hideLoadingOverlay();
      drawView(cachedEntry.data);
      setBadgeState('', '캐시 연동됨');
      document.getElementById('footer-count-text').innerText = `총 ${cachedEntry.data.length}건`;
      return;
    }

    // [수정] 사용자가 버튼을 눌렀을 때(forceRefresh === true)만 화면 전체를 가리는 로딩 오버레이 노출
    if (forceRefresh) {
      showLoadingOverlay(`${sheetName} 데이터 동기화 중...`);
      delete dataCache[sheetName];
      setBadgeState('syncing', '서버 데이터 갱신 중...');
    } else {
      setBadgeState('syncing', '데이터 동기화 중...');
    }

    const cacheBuster = forceRefresh ? `&_t=${Date.now()}` : '';
    const requestUrl = `${API_ENDPOINT}?sheet=${encodeURIComponent(sheetName)}${cacheBuster}&auth=${encodeURIComponent(token)}`;

    fetch(requestUrl, { redirect: 'follow' })
      .then(res => res.json())
      .then(events => {
        if (events.error) {
          throw new Error(events.error);
        }
        const freshData = Array.isArray(events) ? events : [];

        dataCache[sheetName] = {
          data: freshData,
          timestamp: Date.now()
        };

        drawView(freshData);

        setBadgeState('', '실시간 연동됨');
        document.getElementById('footer-count-text').innerText = `총 ${freshData.length}건`;
        document.getElementById('last-sync-time').innerText = `최근 동기화: ${new Date().toLocaleTimeString('ko-KR')}`;
      })
      .catch(err => {
        console.error(err);
        setBadgeState('error', '동기화 오류');
        if (!dataCache[sheetName]) {
          drawView([]);
        }
      })
      .finally(() => {
        hideLoadingOverlay();
      });
  }

  function drawView(events) {
    if (viewMode === 'month') {
      buildMonthGrid(events);
    } else {
      buildWeekGrid(events);
    }
  }

  function buildMonthGrid(events) {
    const holidays = getHolidays();
    const container = document.getElementById('calendar-container');
    container.innerHTML = `
      <div class="weekdays-month">
        <div class="wd sun">Sun</div>
        <div class="wd">Mon</div>
        <div class="wd">Tue</div>
        <div class="wd">Wed</div>
        <div class="wd">Thu</div>
        <div class="wd">Fri</div>
        <div class="wd sat">Sat</div>
      </div>
      <div class="grid-month" id="month-grid-cells"></div>
    `;

    const grid = document.getElementById('month-grid-cells');
    const firstDay = new Date(currentYear, currentMonth - 1, 1);
    const lastDay = new Date(currentYear, currentMonth, 0);

    const startCol = firstDay.getDay();
    const totalDays = lastDay.getDate();
    const prevMonthLastDay = new Date(currentYear, currentMonth - 1, 0).getDate();

    for (let i = startCol - 1; i >= 0; i--) {
      const cell = document.createElement('div');
      cell.className = 'cell out';
      cell.innerHTML = `<div class="d-head"><span class="d-num">${prevMonthLastDay - i}</span></div>`;
      grid.appendChild(cell);
    }

    for (let day = 1; day <= totalDays; day++) {
      const dateStr = `${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const dayOfWeek = new Date(currentYear, currentMonth - 1, day).getDay();
      const isToday = (dateStr === todayDateStr);
      const holidayName = holidays[dateStr];

      const cell = document.createElement('div');
      let cellClasses = ['cell'];
      if (dayOfWeek === 6) cellClasses.push('sat');
      if (dayOfWeek === 0) cellClasses.push('sun');
      if (holidayName) cellClasses.push('holiday');
      if (isToday) cellClasses.push('is-today');
      cell.className = cellClasses.join(' ');

      cell.onclick = (e) => {
        if (e.target.closest('.ev')) return;
        openCreateModal(dateStr);
      };

      let tagHtml = (day === 1) ? `<span class="d-tag">${currentMonth}월</span>` : '';
      let todayTagHtml = isToday ? `<span class="today-tag">오늘</span>` : '';
      let holidayTagHtml = holidayName ? `<span class="holiday-badge" title="${holidayName}">${holidayName}</span>` : '';

      cell.innerHTML = `
        <div class="d-head">
          <div class="d-head-left">
            <span class="d-num">${day}</span>
            ${todayTagHtml}
            ${holidayTagHtml}
          </div>
          ${tagHtml}
        </div>
        <div class="events" id="ev-container-${day}"></div>
      `;
      grid.appendChild(cell);

      const dayEvents = events.filter(e => e.start.startsWith(dateStr));
      const evContainer = cell.querySelector('.events');

      dayEvents.forEach(ev => {
        const cat = ev.extendedProps?.category || '';
        const evClass = getCategoryClass(cat);
        const rawTime = ev.extendedProps?.rawTime || '';
        const memo = ev.extendedProps?.memo || '';

        const memoIndicatorHtml = memo ? `
          <span class="memo-clip-badge" title="비고: ${memo}">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l7.88-7.88"></path>
            </svg>
          </span>
        ` : '';

        const evEl = document.createElement('div');
        evEl.className = evClass;
        evEl.innerHTML = `
          <div class="ev-top-row">
            <span class="ev-time">${rawTime}</span>
            ${memoIndicatorHtml}
          </div>
          <span class="ev-title">${ev.title.replace(/\[.*?\]\s*/, '')}</span>
        `;
        evEl.onclick = (e) => {
          e.stopPropagation();
          openModal(ev);
        };
        evEl.onmouseenter = (e) => showTooltip(e, ev);
        evEl.onmousemove = (e) => moveTooltip(e);
        evEl.onmouseleave = hideTooltip;
        evContainer.appendChild(evEl);
      });
    }

    const totalCells = grid.children.length;
    const remaining = (7 - (totalCells % 7)) % 7;
    for (let i = 1; i <= remaining; i++) {
      const cell = document.createElement('div');
      cell.className = 'cell out';
      const tagHtml = (i === 1) ? `<span class="d-tag">${(currentMonth % 12) + 1}월</span>` : '';
      cell.innerHTML = `<div class="d-head"><span class="d-num">${i}</span>${tagHtml}</div>`;
      grid.appendChild(cell);
    }
  }

  function buildWeekGrid(events) {
    const holidays = getHolidays();
    const container = document.getElementById('calendar-container');
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const weekDays = [];

    const activeSlots = getOperationalSlots(currentMonth);

    for (let i = 0; i < 7; i++) {
      const d = new Date(currentWeekStart);
      d.setDate(d.getDate() + i);
      weekDays.push(d);
    }

    let html = `
      <div class="grid-week-wrapper">
        <div class="week-header">
          <div class="week-slot-head">회차 / 시간</div>
    `;

    weekDays.forEach((d, idx) => {
      const yyyy = d.getFullYear();
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      const colDateStr = `${yyyy}-${mm}-${dd}`;
      const isToday = (colDateStr === todayDateStr);
      const holidayName = holidays[colDateStr];

      const isSat = idx === 6;
      const isSun = idx === 0;
      let colClass = 'week-day-col';
      if (isSat) colClass += ' sat';
      if (isSun) colClass += ' sun';
      if (holidayName) colClass += ' holiday';
      if (isToday) colClass += ' is-today';

      const holidayText = holidayName ? `<div style="font-size:10px; font-weight:800; color:var(--sun); margin-top:1px;">${holidayName}</div>` : '';

      html += `
        <div class="${colClass}">
          <div class="w-dname">${dayNames[idx]}</div>
          <div class="w-dnum">${d.getMonth()+1}.${d.getDate()}</div>
          ${holidayText}
        </div>
      `;
    });

    html += `</div><div class="week-body">`;

    activeSlots.forEach((slot, slotIdx) => {
      const slotNum = slotIdx + 1;
      const slotStartTime = slot.time.split('~')[0];

      html += `
        <div class="week-row">
          <div class="time-col">
            <span class="slot-name">${slot.name}</span>
            <span class="slot-hours">${slot.time}</span>
          </div>
      `;

      weekDays.forEach((d, idx) => {
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const dateStr = `${yyyy}-${mm}-${dd}`;
        const isToday = (dateStr === todayDateStr);
        const holidayName = holidays[dateStr];

        const isSat = idx === 6;
        const isSun = idx === 0;
        let cellClass = 'slot-cell';
        if (isSat) cellClass += ' sat';
        if (isSun) cellClass += ' sun';
        if (holidayName) cellClass += ' holiday';
        if (isToday) cellClass += ' is-today';

        const matched = events.filter(e => {
          if (!e.start.startsWith(dateStr)) return false;
          const raw = e.extendedProps?.rawTime || '';

          if (raw.includes('종일')) return true;

          const roundMatch = raw.match(/(\d+)회차/);
          if (roundMatch) {
            return parseInt(roundMatch[1], 10) === slotNum;
          }

          const timeMatch = raw.match(/(\d{1,2}:\d{2})\s*~/);
          if (timeMatch) {
            const startHourMin = timeMatch[1].padStart(5, '0');
            return startHourMin === slotStartTime;
          }

          return false;
        });

        html += `<div class="${cellClass}" onclick="openCreateModal('${dateStr}')" id="slot-${dateStr}-${slot.name}">`;
        matched.forEach(ev => {
          const cat = ev.extendedProps?.category || '';
          const evClass = getCategoryClass(cat);
          const memo = ev.extendedProps?.memo || '';

          const memoIndicatorHtml = memo ? `
            <span class="memo-clip-badge" title="비고: ${memo}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l7.88-7.88"></path>
              </svg>
            </span>
          ` : '';

          html += `
            <div class="${evClass}" 
                 onclick='event.stopPropagation(); openModal(${JSON.stringify(ev)})'
                 onmouseenter='showTooltip(event, ${JSON.stringify(ev)})'
                 onmousemove='moveTooltip(event)'
                 onmouseleave='hideTooltip()'>
              <div class="ev-top-row">
                <span class="ev-time">${ev.extendedProps?.rawTime || ''}</span>
                ${memoIndicatorHtml}
              </div>
              <span class="ev-title">${ev.title.replace(/\[.*?\]\s*/, '')}</span>
            </div>
          `;
        });
        html += `</div>`;
      });

      html += `</div>`;
    });

    html += `</div></div>`;
    container.innerHTML = html;
  }

  const tooltip = document.getElementById('tooltip');

  function showTooltip(e, ev) {
    const rawTime = ev.extendedProps?.rawTime || ev.start;
    const cat = ev.extendedProps?.category || '-';
    const agency = ev.extendedProps?.agency || '-';
    const status = ev.extendedProps?.status || '등록 대기';
    const fee = ev.extendedProps?.fee || '무료';
    const memo = ev.extendedProps?.memo || '';
    const title = ev.title.replace(/\[.*?\]\s*/, '');

    const isPaymentPending = status.replace(/\s+/g, '').includes('결제대기');
    const statusHtml = isPaymentPending 
      ? `<b class="tt-status-pending">⚠️ ${status}</b>` 
      : `<b>${status}</b>`;

    let memoHtml = memo ? `<div class="tt-row tt-memo">비고: <b>${memo}</b></div>` : '';

    tooltip.innerHTML = `
      <div class="tt-title">${title}</div>
      <div class="tt-row">시간: <b>${rawTime}</b></div>
      <div class="tt-row">요청기관: <b>${agency}</b></div>
      <div class="tt-row">대관료: <b>${typeof fee === 'number' ? fee.toLocaleString() + '원' : fee}</b></div>
      <div class="tt-row">구분: <b>${cat}</b></div>
      <div class="tt-row">상태: ${statusHtml}</div>
      ${memoHtml}
    `;
    tooltip.style.display = 'block';
    moveTooltip(e);
  }

  function moveTooltip(e) {
    const offset = 12;
    tooltip.style.left = `${e.clientX + offset}px`;
    tooltip.style.top = `${e.clientY + offset}px`;
  }

  function hideTooltip() {
    tooltip.style.display = 'none';
  }

  function openModal(ev) {
    hideTooltip();
    selectedEvent = ev;

    const status = ev.extendedProps?.status || '등록 대기';
    const fee = ev.extendedProps?.fee || '무료';
    const isPaymentPending = status.replace(/\s+/g, '').includes('결제대기');

    document.getElementById('m-team').innerText = ev.title;
    document.getElementById('m-time').innerText = ev.extendedProps?.rawTime || ev.start;
    document.getElementById('m-cat').innerText = ev.extendedProps?.category || '-';
    document.getElementById('m-agency').innerText = ev.extendedProps?.agency || '-';
    document.getElementById('m-fee').innerText = typeof fee === 'number' ? fee.toLocaleString() + '원' : fee;

    const statusEl = document.getElementById('m-status');
    statusEl.innerHTML = isPaymentPending
      ? `<span class="status-text-pending">${status}</span>`
      : `<span class="status-text-normal">${status}</span>`;

    const memo = ev.extendedProps?.memo || '';
    const memoContainer = document.getElementById('m-memo-container');
    if (memo) {
      document.getElementById('m-memo').innerText = memo;
      memoContainer.style.display = 'block';
    } else {
      memoContainer.style.display = 'none';
    }

    document.getElementById('modal').style.display = 'flex';
  }

  function closeModal(e) {
    if (e.target.id === 'modal') {
      document.getElementById('modal').style.display = 'none';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    checkAuthGate();
  });

  // 1. 창으로 다시 돌아왔을 때 무음(Silent) 갱신
  window.addEventListener('focus', () => {
    if (typeof renderCalendar === 'function') {
      renderCalendar(false);
    }
  });

  // 2. 30초 주기 자동 갱신 시에도 무음(Silent) 갱신
  setInterval(() => {
    if (typeof renderCalendar === 'function') {
      renderCalendar(false);
    }
  }, 30000);

</script>

</body>
</html>
