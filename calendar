<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>동명근린공원 축구장 대관 예약 관리</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  @page { size: A4 landscape; margin: 0; }

  :root {
    --bg: #f8fafc;
    --paper: #ffffff;
    --surface: #f8fafc;
    --ink: #0f172a;
    --ink-2: #334155;
    --ink-3: #64748b;
    --ink-4: #94a3b8;
    --line: #e2e8f0;
    --line-2: #f1f5f9;

    --sat: #2563eb;
    --sat-soft: #eff6ff;
    --sun: #dc2626;
    --sun-soft: #fef2f2;

    --today-accent: #2563eb;
    --today-bg: rgba(37, 99, 235, 0.04);
    --today-border: #bfdbfe;

    --cat-a: #4f46e5;
    --cat-a-bg: #eef2ff;
    --cat-b: #d97706;
    --cat-b-bg: #fffbeb;
    --cat-c: #059669;
    --cat-c-bg: #ecfdf5;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    background: var(--bg);
    font-family: 'Noto Sans KR', system-ui, -apple-system, sans-serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  body {
    display: flex; align-items: flex-start; justify-content: center;
    padding: 24px; min-height: 100vh;
  }
  .page {
    width: 1220px; min-height: 860px;
    background: var(--paper);
    padding: 24px 28px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    position: relative;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  /* 보안 게이트웨이 */
  #auth-gate-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
    z-index: 999999;
    display: flex;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  #auth-gate-overlay.hidden {
    display: none !important;
  }

  .status-text-pending { color: #dc2626; font-weight: 700; }
  .status-text-normal { color: var(--ink-2); font-weight: 600; }
  .tt-status-pending {
    color: #f87171 !important;
    font-weight: 800 !important;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .header-upcoming {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 12px;
    position: relative;
  }
  .title-area { display: flex; flex-direction: column; gap: 4px; }
  .title-row { display: flex; align-items: center; gap: 12px; }
  .main-heading {
    font-size: 28px;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .live-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    background: #f1f5f9;
    border: 1px solid var(--line);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-3);
    transition: all 0.2s ease;
  }
  .pulse-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
  }
  .pulse-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }
  .pulse-ring {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
    opacity: 0.5;
    animation: live-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .live-status-badge.syncing {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #2563eb;
  }
  .live-status-badge.syncing .pulse-dot {
    background: #2563eb;
    border: 2px solid #93c5fd;
    border-top-color: #2563eb;
    animation: spin 0.8s linear infinite;
    width: 8px;
    height: 8px;
  }
  .live-status-badge.syncing .pulse-ring { display: none; }
  .live-status-badge.error {
    background: #fef2f2;
    border-color: #fecaca;
    color: #dc2626;
  }
  .live-status-badge.error .pulse-dot { background: #dc2626; }
  .live-status-badge.error .pulse-ring { display: none; }

  @keyframes live-pulse {
    0% { transform: scale(0.95); opacity: 0.7; }
    50% { transform: scale(1.8); opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .picker-trigger-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .sub-date-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid transparent;
    padding: 4px 8px 4px 6px;
    border-radius: 6px;
    cursor: pointer;
    font-family: 'Manrope', 'Noto Sans KR', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.01em;
    transition: all 0.15s ease;
  }
  .sub-date-btn:hover { background: #e2e8f0; color: var(--today-accent); }
  .picker-caret-svg {
    display: block;
    color: var(--ink-3);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), color 0.15s;
  }
  .sub-date-btn:hover .picker-caret-svg { color: var(--today-accent); }
  .sub-date-btn.active .picker-caret-svg {
    transform: rotate(180deg);
    color: var(--today-accent);
  }

  .month-picker-popover {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 1000;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    padding: 12px;
    width: 250px;
  }
  .popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-2);
  }
  .popover-year-title { font-weight: 800; font-size: 14px; color: var(--ink); }
  .popover-year-nav { display: flex; gap: 2px; }
  .popover-year-nav button {
    background: transparent;
    border: none;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    font-size: 11px;
    cursor: pointer;
    color: var(--ink-3);
    display: flex; align-items: center; justify-content: center;
    padding: 0;
    transition: all 0.15s ease;
  }
  .popover-year-nav button:hover { background: var(--line-2); color: var(--ink); }

  .month-grid-picker {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .btn-month-chip {
    background: transparent;
    border: 1px solid transparent;
    padding: 7px 0;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.1s;
  }
  .btn-month-chip:hover { background: #f1f5f9; color: var(--ink); }
  .btn-month-chip.current {
    background: var(--cat-a-bg);
    color: var(--cat-a);
    font-weight: 800;
    border-color: #c7d2fe;
  }

  .control-area { display: flex; align-items: center; gap: 10px; }
  .legend-cluster { display: flex; align-items: center; gap: 10px; padding-right: 4px; }
  .legend-chip { display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; color: var(--ink-2); }
  .legend-indicator { width: 9px; height: 9px; border-radius: 2px; }
  .legend-indicator.a { background: var(--cat-a); }
  .legend-indicator.c { background: var(--cat-c); }
  .legend-indicator.b { background: var(--cat-b); }

  .btn-add-booking {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0 12px;
    height: 34px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .btn-add-booking:hover { background: #1d4ed8; }

  .nav-capsule {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    height: 34px;
  }
  .nav-btn {
    background: transparent;
    border: none;
    padding: 0 11px;
    height: 100%;
    color: var(--ink-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 12px;
    font-weight: 600;
  }
  .nav-btn.btn-today { font-weight: 700; color: var(--ink); }
  .nav-btn:hover { background: #f1f5f9; color: var(--ink); }
  .nav-divider { width: 1px; height: 18px; background: var(--line); }

  .view-segment {
    display: inline-flex;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2px;
    height: 34px;
  }
  .btn-view-toggle {
    background: transparent;
    border: none;
    padding: 0 11px;
    height: 100%;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-3);
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s;
  }
  .btn-view-toggle.active {
    background: #f1f5f9;
    color: var(--ink);
    font-weight: 700;
  }

  /* 캘린더 컨테이너 & 스켈레톤 로딩 */
  .calendar-outer-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: 8px;
    overflow: hidden;
  }
  .calendar {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper);
    flex: 1;
    transition: filter 0.2s ease;
  }

  /* 스켈레톤 로딩 오버레이 */
  .calendar-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 50;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .calendar-loading-overlay.active {
    display: flex;
  }
  .loading-card-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    padding: 10px 18px;
    border-radius: 30px;
    box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .loading-spinner {
    width: 16px;
    height: 16px;
    border: 2.5px solid #dbeafe;
    border-top-color: #2563eb;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .weekdays-month {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .wd {
    padding: 10px 12px;
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    text-transform: uppercase;
    text-align: left;
    border-right: 1px solid var(--line);
  }
  .wd:last-child { border-right: none; }
  .wd.sat { color: var(--sat); }
  .wd.sun { color: var(--sun); }

  .grid-month {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    grid-auto-rows: minmax(115px, 1fr);
  }
  .cell {
    border-right: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
    padding: 8px;
    position: relative;
    display: flex; flex-direction: column;
    background: var(--paper);
    transition: background 0.1s;
    cursor: pointer;
  }
  .cell:hover { background: #fafcff; }
  .cell:nth-child(7n) { border-right: none; }
  .cell.out { background: #fbfcfe; cursor: default; }
  .cell.out .d-num { color: var(--ink-4); }

  .cell.sat::before, .cell.sun::before, .cell.holiday::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.35;
  }
  .cell.sat::before { background: var(--sat-soft); }
  .cell.sun::before, .cell.holiday::before { background: var(--sun-soft); }
  .cell > * { position: relative; z-index: 1; }

  .cell.is-today { background-color: var(--today-bg) !important; }
  .cell.is-today::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--today-accent);
    z-index: 2;
  }
  .cell.is-today .d-num {
    background: var(--today-accent);
    color: #ffffff !important;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13.5px !important;
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
  }
  .today-tag {
    font-size: 10px;
    font-weight: 800;
    color: var(--today-accent);
    background: #dbeafe;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 6px;
    letter-spacing: -0.01em;
  }

  .cell.holiday .d-num { color: var(--sun) !important; }
  .holiday-badge {
    font-size: 10.5px;
    font-weight: 800;
    color: var(--sun);
    background: #fee2e2;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 5px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 90px;
  }

  .d-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .d-head-left { display: flex; align-items: center; }
  .d-num { font-family: 'Manrope', sans-serif; font-size: 15px; font-weight: 800; color: var(--ink); }
  .cell.sat .d-num { color: var(--sat); }
  .cell.sun .d-num { color: var(--sun); }
  .d-tag { font-size: 10.5px; font-weight: 700; color: var(--ink-4); font-family: 'Manrope', sans-serif; }

  .events { display: flex; flex-direction: column; gap: 4px; flex: 1; min-height: 0; }
  .ev {
    display: flex; flex-direction: column;
    padding: 5px 8px 6px;
    border-radius: 4px;
    line-height: 1.35;
    border-left: 3.5px solid;
    background: #fff;
    cursor: pointer;
    transition: transform 0.08s ease;
  }
  .ev:hover { transform: translateY(-1px); }

  .ev-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
  }

  .memo-clip-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    opacity: 0.85;
    transition: color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }
  .ev:hover .memo-clip-badge {
    color: var(--today-accent);
    transform: scale(1.1);
    opacity: 1;
  }

  .ev-time {
    font-family: 'Manrope', 'Noto Sans KR', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.01em;
  }
  .ev-title {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
    margin-top: 2px;
    word-break: keep-all;
  }

  .ev.a { background: var(--cat-a-bg); border-left-color: var(--cat-a); }
  .ev.a .ev-time { color: var(--cat-a); }
  .ev.b { background: var(--cat-b-bg); border-left-color: var(--cat-b); }
  .ev.b .ev-time { color: var(--cat-b); }
  .ev.c { background: var(--cat-c-bg); border-left-color: var(--cat-c); }
  .ev.c .ev-time { color: var(--cat-c); }

  .grid-week-wrapper { display: flex; flex-direction: column; flex: 1; overflow-y: auto; }
  .week-header {
    display: grid;
    grid-template-columns: 100px repeat(7, 1fr);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: sticky; top: 0; z-index: 5;
  }
  .week-slot-head { padding: 10px 6px; text-align: center; font-size: 11.5px; font-weight: 800; color: var(--ink-3); border-right: 1px solid var(--line); }
  .week-day-col { padding: 10px; text-align: center; border-right: 1px solid var(--line-2); position: relative; }
  .week-day-col:last-child { border-right: none; }
  .week-day-col .w-dname { font-family: 'Manrope', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--ink-3); }
  .week-day-col .w-dnum { font-family: 'Manrope', sans-serif; font-size: 14.5px; font-weight: 800; color: var(--ink); margin-top: 2px; }
  .week-day-col.sat .w-dname, .week-day-col.sat .w-dnum { color: var(--sat); }
  .week-day-col.sun .w-dname, .week-day-col.sun .w-dnum { color: var(--sun); }
  .week-day-col.holiday .w-dname, .week-day-col.holiday .w-dnum { color: var(--sun) !important; }

  .week-day-col.is-today { background-color: var(--today-bg); }
  .week-day-col.is-today .w-dnum {
    background: var(--today-accent);
    color: #ffffff !important;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 2px auto 0;
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
  }

  .week-body { display: flex; flex-direction: column; }
  .week-row { display: grid; grid-template-columns: 100px repeat(7, 1fr); border-bottom: 1px solid var(--line-2); min-height: 95px; }
  .time-col {
    padding: 10px 8px; background: var(--surface); border-right: 1px solid var(--line);
    text-align: center; display: flex; flex-direction: column; justify-content: center; gap: 3px;
  }
  .time-col .slot-name { font-size: 12.5px; font-weight: 800; color: var(--ink); }
  .time-col .slot-hours { font-size: 10.5px; color: var(--ink-3); font-family: 'Manrope', sans-serif; font-weight: 600; }
  
  .slot-cell { border-right: 1px solid var(--line-2); padding: 5px; display: flex; flex-direction: column; gap: 4px; background: var(--paper); cursor: pointer; }
  .slot-cell:last-child { border-right: none; }
  .slot-cell.sat { background: #fafcff; }
  .slot-cell.sun, .slot-cell.holiday { background: #fffafa; }
  .slot-cell.is-today { background-color: var(--today-bg) !important; }

  #tooltip {
    position: fixed; display: none; pointer-events: none; z-index: 10000;
    background: rgba(15, 23, 42, 0.96); color: #fff; padding: 11px 15px;
    border-radius: 6px; line-height: 1.6; box-shadow: 0 4px 16px rgba(0,0,0,0.22);
    backdrop-filter: blur(4px); white-space: nowrap;
  }
  #tooltip .tt-title {
    font-weight: 800; font-size: 13.5px; margin-bottom: 6px; color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 4px;
  }
  #tooltip .tt-row { color: #cbd5e1; font-size: 12px; margin: 2px 0; }
  #tooltip .tt-row b { color: #f8fafc; font-weight: 700; }
  #tooltip .tt-memo { color: #ff9c6e; font-weight: 600; }

  #modal, #holiday-modal, #create-modal {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4);
    justify-content: center; align-items: center; z-index: 1000;
    backdrop-filter: blur(4px);
  }
  .modal-box {
    background: #fff; padding: 24px; border-radius: 10px; width: 420px;
    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.15);
  }
  .modal-box h4 { margin-bottom: 14px; font-size: 18px; font-weight: 800; color: var(--ink); }
  .modal-box p { font-size: 13.5px; margin: 8px 0; color: var(--ink-2); display: flex; justify-content: space-between; gap: 12px; }
  .modal-box p strong { color: var(--ink); flex-shrink: 0; }

  .form-group { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
  .form-group label { font-size: 12px; font-weight: 700; color: var(--ink-2); }
  .form-group input, .form-group select, .form-group textarea {
    padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; font-size: 13px; font-family: inherit; outline: none;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--today-accent); }

  .footer {
    display: flex; justify-content: space-between; align-items: center;
